#!/bin/bash

# MCP Server Management Script
# Manages both Node.js and Camel Quarkus MCP servers

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_SERVER_DIR="$SCRIPT_DIR/mcp-servers/node-js"
QUARKUS_SERVER_DIR="$SCRIPT_DIR/mcp-servers/camel-quarkus"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

function log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

function log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

function log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

function check_nodejs_installed() {
    if ! command -v node &> /dev/null; then
        log_error "Node.js is not installed"
        exit 1
    fi
}

function check_java_installed() {
    if ! command -v java &> /dev/null; then
        log_error "Java is not installed"
        exit 1
    fi
}

# ===== Node.js Server Functions =====

function get_node_pid() {
    # Find node process by working directory
    for pid in $(pgrep -f "node.*index.js"); do
        local cwd=$(pwdx $pid 2>/dev/null | awk '{print $2}')
        if [ "$cwd" == "$NODE_SERVER_DIR" ]; then
            echo $pid
            return
        fi
    done
}

function is_node_running() {
    local pid=$(get_node_pid)
    [ -n "$pid" ]
}

function start_node() {
    log_info "${BLUE}[Node.js]${NC} Starting MCP server..."

    if is_node_running; then
        local existing_pid=$(get_node_pid)
        log_warn "${BLUE}[Node.js]${NC} Server is already running (PID: $existing_pid)"
        return 0
    fi

    check_nodejs_installed

    cd "$NODE_SERVER_DIR" || {
        log_error "${BLUE}[Node.js]${NC} Cannot access server directory: $NODE_SERVER_DIR"
        exit 1
    }

    if [ ! -d "node_modules" ]; then
        log_info "${BLUE}[Node.js]${NC} Installing dependencies..."
        npm install > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            log_error "${BLUE}[Node.js]${NC} npm install failed"
            exit 1
        fi
    fi

    log_info "${BLUE}[Node.js]${NC} Starting server..."
    nohup npm start > "$NODE_SERVER_DIR/server.log" 2>&1 &

    # Wait for process to appear
    sleep 3

    if is_node_running; then
        local pid=$(get_node_pid)
        log_info "${BLUE}[Node.js]${NC} Server started (PID: $pid)"
        local port=$(grep "^server.port=" "$NODE_SERVER_DIR/application.properties" 2>/dev/null | cut -d'=' -f2)
        log_info "${BLUE}[Node.js]${NC} Endpoint: http://localhost:${port:-9090}/mcp"
    else
        log_error "${BLUE}[Node.js]${NC} Failed to start. Check: $NODE_SERVER_DIR/server.log"
        exit 1
    fi
}

function stop_node() {
    log_info "${BLUE}[Node.js]${NC} Stopping MCP server..."

    local pid=$(get_node_pid)

    if [ -z "$pid" ]; then
        log_warn "${BLUE}[Node.js]${NC} Server is not running"
        return 0
    fi

    log_info "${BLUE}[Node.js]${NC} Stopping server (PID: $pid)..."

    # Kill the node process and any child processes
    pkill -P $pid 2>/dev/null
    kill $pid 2>/dev/null

    # Wait for graceful shutdown
    local waited=0
    while [ $waited -lt 10 ]; do
        if ! is_node_running; then
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    # Force kill if still running
    if is_node_running; then
        log_warn "${BLUE}[Node.js]${NC} Forcing shutdown..."
        kill -9 $pid 2>/dev/null
        sleep 1
    fi

    if is_node_running; then
        log_error "${BLUE}[Node.js]${NC} Failed to stop server"
        exit 1
    else
        log_info "${BLUE}[Node.js]${NC} Server stopped"
    fi
}

function status_node() {
    local pid=$(get_node_pid)

    if [ -n "$pid" ]; then
        log_info "${BLUE}[Node.js]${NC} Server is ${GREEN}RUNNING${NC} (PID: $pid)"
        local port=$(grep "^server.port=" "$NODE_SERVER_DIR/application.properties" 2>/dev/null | cut -d'=' -f2)
        log_info "${BLUE}[Node.js]${NC} Endpoint: http://localhost:${port:-9090}/mcp"
    else
        log_warn "${BLUE}[Node.js]${NC} Server is ${RED}NOT RUNNING${NC}"
    fi
}

function logs_node() {
    local log_file="$NODE_SERVER_DIR/server.log"
    if [ ! -f "$log_file" ]; then
        log_warn "${BLUE}[Node.js]${NC} Log file not found"
        return 1
    fi

    if [ "$1" == "-f" ]; then
        tail -f "$log_file"
    else
        tail -n 50 "$log_file"
    fi
}

# ===== Quarkus Server Functions =====

function get_quarkus_pid() {
    # Find java process running from the specific server directory (the actual Quarkus app, not mvnw)
    for pid in $(pgrep -f "java.*quarkus"); do
        local cmdline=$(cat /proc/$pid/cmdline 2>/dev/null | tr '\0' ' ')
        if [[ "$cmdline" == *"mcp-servers/camel-quarkus"* ]]; then
            echo $pid
            return
        fi
    done
}

function is_quarkus_running() {
    local pid=$(get_quarkus_pid)
    [ -n "$pid" ]
}

function start_quarkus() {
    log_info "${YELLOW}[Quarkus]${NC} Starting MCP server..."

    if is_quarkus_running; then
        local existing_pid=$(get_quarkus_pid)
        log_warn "${YELLOW}[Quarkus]${NC} Server is already running (PID: $existing_pid)"
        return 0
    fi

    check_java_installed

    cd "$QUARKUS_SERVER_DIR" || {
        log_error "${YELLOW}[Quarkus]${NC} Cannot access server directory: $QUARKUS_SERVER_DIR"
        exit 1
    }

    log_info "${YELLOW}[Quarkus]${NC} Starting Quarkus dev mode..."
    nohup ./mvnw quarkus:dev -Dquarkus.log.console.enable=true > "$QUARKUS_SERVER_DIR/server.log" 2>&1 &

    # Quarkus takes longer to start
    log_info "${YELLOW}[Quarkus]${NC} Waiting for Quarkus to start (this may take 10-20 seconds)..."
    sleep 5

    # Wait for Quarkus to be fully ready
    local waited=0
    while [ $waited -lt 30 ]; do
        if grep -q "Listening on:" "$QUARKUS_SERVER_DIR/server.log" 2>/dev/null; then
            local pid=$(get_quarkus_pid)
            log_info "${YELLOW}[Quarkus]${NC} Server started (PID: $pid)"
            local port=$(grep "^quarkus.http.port=" "$QUARKUS_SERVER_DIR/src/main/resources/application.properties" 2>/dev/null | cut -d'=' -f2)
            log_info "${YELLOW}[Quarkus]${NC} Endpoint: http://localhost:${port:-8080}/mcp"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    if is_quarkus_running; then
        log_warn "${YELLOW}[Quarkus]${NC} Server started but may not be fully ready yet. Check logs."
    else
        log_error "${YELLOW}[Quarkus]${NC} Failed to start. Check: $QUARKUS_SERVER_DIR/server.log"
        exit 1
    fi
}

function stop_quarkus() {
    log_info "${YELLOW}[Quarkus]${NC} Stopping MCP server..."

    local pid=$(get_quarkus_pid)

    if [ -z "$pid" ]; then
        log_warn "${YELLOW}[Quarkus]${NC} Server is not running"
        return 0
    fi

    log_info "${YELLOW}[Quarkus]${NC} Stopping server (PID: $pid)..."

    # Quarkus dev mode responds to SIGINT (Ctrl+C)
    kill -INT $pid 2>/dev/null

    local waited=0
    while [ $waited -lt 15 ]; do
        if ! is_quarkus_running; then
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    # Force kill if still running
    if is_quarkus_running; then
        log_warn "${YELLOW}[Quarkus]${NC} Forcing shutdown..."
        # Kill the entire process tree
        pkill -9 -P $pid 2>/dev/null
        kill -9 $pid 2>/dev/null
        sleep 1
    fi

    if is_quarkus_running; then
        log_error "${YELLOW}[Quarkus]${NC} Failed to stop server"
        exit 1
    else
        log_info "${YELLOW}[Quarkus]${NC} Server stopped"
    fi
}

function status_quarkus() {
    local pid=$(get_quarkus_pid)

    if [ -n "$pid" ]; then
        log_info "${YELLOW}[Quarkus]${NC} Server is ${GREEN}RUNNING${NC} (PID: $pid)"
        local port=$(grep "^quarkus.http.port=" "$QUARKUS_SERVER_DIR/src/main/resources/application.properties" 2>/dev/null | cut -d'=' -f2)
        log_info "${YELLOW}[Quarkus]${NC} Endpoint: http://localhost:${port:-8080}/mcp"
    else
        log_warn "${YELLOW}[Quarkus]${NC} Server is ${RED}NOT RUNNING${NC}"
    fi
}

function logs_quarkus() {
    local log_file="$QUARKUS_SERVER_DIR/server.log"
    if [ ! -f "$log_file" ]; then
        log_warn "${YELLOW}[Quarkus]${NC} Log file not found"
        return 1
    fi

    if [ "$1" == "-f" ]; then
        tail -f "$log_file"
    else
        tail -n 50 "$log_file"
    fi
}

# ===== Combined Functions =====

function start() {
    local server="${1:-all}"
    case "$server" in
        node|nodejs)
            start_node
            ;;
        quarkus)
            start_quarkus
            ;;
        all)
            start_node
            echo ""
            start_quarkus
            ;;
        *)
            log_error "Unknown server: $server. Use 'node', 'quarkus', or 'all'"
            exit 1
            ;;
    esac
}

function stop() {
    local server="${1:-all}"
    case "$server" in
        node|nodejs)
            stop_node
            ;;
        quarkus)
            stop_quarkus
            ;;
        all)
            stop_node
            echo ""
            stop_quarkus
            ;;
        *)
            log_error "Unknown server: $server. Use 'node', 'quarkus', or 'all'"
            exit 1
            ;;
    esac
}

function restart() {
    local server="${1:-all}"
    stop "$server"
    sleep 2
    start "$server"
}

function status() {
    local server="${1:-all}"
    case "$server" in
        node|nodejs)
            status_node
            ;;
        quarkus)
            status_quarkus
            ;;
        all)
            log_info "Checking MCP servers status..."
            echo ""
            status_node
            echo ""
            status_quarkus
            ;;
        *)
            log_error "Unknown server: $server. Use 'node', 'quarkus', or 'all'"
            exit 1
            ;;
    esac
}

function logs() {
    local server="$1"
    local follow="$2"

    case "$server" in
        node|nodejs)
            logs_node "$follow"
            ;;
        quarkus)
            logs_quarkus "$follow"
            ;;
        *)
            log_error "Please specify server: 'node' or 'quarkus'"
            exit 1
            ;;
    esac
}

function usage() {
    cat << EOF
MCP Server Management Script

Usage: $0 <command> [server] [options]

Commands:
    start [server]      Start MCP server(s)
    stop [server]       Stop MCP server(s)
    restart [server]    Restart MCP server(s)
    status [server]     Check server status
    logs <server> [-f]  Show server logs
    help                Show this help message

Servers:
    node, nodejs        Node.js MCP server (port 9090)
    quarkus            Camel Quarkus MCP server (port 9091)
    all                Both servers (default)

Options:
    -f, --follow       Follow logs in real-time (use with logs command)

Examples:
    $0 start              # Start both servers
    $0 start node         # Start only Node.js server
    $0 status             # Check status of both servers
    $0 logs quarkus -f    # Follow Quarkus logs
    $0 stop all           # Stop both servers

Note: This script detects servers by process pattern, not PID files.
      It will detect and manage servers started manually or by other means.

EOF
}

# Main script
case "${1:-}" in
    start)
        start "${2:-all}"
        ;;
    stop)
        stop "${2:-all}"
        ;;
    restart)
        restart "${2:-all}"
        ;;
    status)
        status "${2:-all}"
        ;;
    logs)
        if [ -z "$2" ]; then
            log_error "Please specify which server logs to view: 'node' or 'quarkus'"
            exit 1
        fi
        logs "$2" "$3"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        log_error "Unknown command: ${1:-}"
        echo ""
        usage
        exit 1
        ;;
esac
